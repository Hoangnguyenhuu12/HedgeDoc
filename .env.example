# Configuration for HedgeDoc System
# Copy this file to .env and fill in your API credentials

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration (Options: gemini, openai, ollama)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# Ollama Local Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Configuration (Options: gemini, openai, ollama)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-2

# Vector Store Configuration
VECTOR_STORE_DIR=./data/vector_store
CHROMA_COLLECTION_NAME=hedgedoc_knowledge_base

# Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
